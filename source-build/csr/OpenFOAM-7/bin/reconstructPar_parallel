#   echo ""
#   exit
#fi

sw_run="bsub -I -m 1 -b -p -q q_share -shared -host_stack 5000 -share_size 12000 -cgsp 64 -ro_size 128 -n 1 "

appname="/home/export/online1/mdt00/shisuan/swpkuqzh/OpenFOAM/OpenFOAM-8/platforms/linux64sw9gccDPInt64Opt/bin/reconstructPar"
#appflag="-noZero"
appflag=" $1 $2 $3 $4 $5 $6 $7"

#set max jobs as value input for np
#njobs=$1
#let njobs1=$njobs+1  
#running reconstructPar -noZero in pseudo-parallel mode on njobs processors
#echo "running $appname $appflag in pseudo-parallel mode on $njobs processors"

#计算processor0目录下的文件数量，并将这个数量赋值给变量nsteps。
#ls processor0：列出processor0目录下的所有文件和子目录。
#|：管道符，将ls命令的输出作为wc -l命令的输入。
#wc -l：计算输入中的行数，这里就是processor0目录下的文件数量。
#nsteps变量的值就是processor0目录下的文件数量。

nsteps1=`ls processor0 | wc -l`
let nsteps=$( expr $nsteps1 - 1 )

echo "running $appname $appflag in pseudo-parallel mode on $nsteps processors"

#echo "nsteps= $nsteps"

#计算每个处理器应该处理的文件块的数量，并将这个数量赋值给变量nchunk。
#echo $nsteps/$njobs+1：将nsteps除以njobs，然后加1，并将结果输出。
#| bc：将输出作为bc命令的输入，bc是一个任意精度的计算器语言。
#nchunk=：将bc命令的输出赋值给变量nchunk。
#nchunk变量的值就是每个处理器应该处理的文件块的数量。这里使用bc是为了确保计算结果的准确性，特别是在处理大数时。

#nchunk=`echo $nsteps/$njobs | bc`

#echo "nchunk = $nchunk"

#找到processor0目录下最大的文件名，并将这个文件名赋值给变量tmin。
#ls processor0：列出processor0目录下的所有文件名。
#| sort -nr：将输出作为sort命令的输入，sort命令将文件名按照数值大小进行降序排序。
#| tail -1：将排序后的输出作为tail命令的输入，tail命令将输出最后一个文件名。
#tmin=：将tail命令的输出赋值给变量tmin。
#tmin变量的值就是processor0目录下最小的文件名。tmax变量的值就是processor0目录下最大的文件名。
#这里使用sort和tail命令是为了找到最小的文件名，而-nr选项确保了按照数值大小进行降序排序。

#find max time
tmin=`ls processor0 | sort -nr | tail -1`
#echo "tmin = $tmin"
tmax=`ls processor0 | sort -nr | head -1`
#echo "tmax = $tmax"

#创建临时文件夹
#echo "making temp dir"
tempdir="./temp.parReconstructPar"
if [ ! -d $tempdir ]; then
	echo "making temp log dir : $temdir"
	mkdir $tempdir
fi


for ii in  $(ls processor0)
do
	if [[ "$ii" == "constant" || "$ii" == "0" ]]
	then
		continue
	fi
	
	`setsid $sw_run $appname $appflag -time "$ii" > $tempdir/output$ii  2>&1  &`
	sleep 0.1
done


exit

