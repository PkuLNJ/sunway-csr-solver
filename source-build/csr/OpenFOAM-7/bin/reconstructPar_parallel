#if [ -z "$1" ];：检查$1是否为空字符串。
#then：如果$1为空，则执行then后面的命令
#bash脚本以伪并行模式运行reconstructPar
#通过将时间目录分解为多个范围
#$0：表示脚本本身的名称。
#<NP>：表示要使用的处理器数量，这是必须的参数。
#<outputfile>：表示输出文件的名称，这是可选的参数。
#如果提供了这个参数，脚本会将输出保存到指定的文件中；如果没有提供，脚本可能将输出打印到标准输出（通常是终端）

#if [ -z "$1" ]; then 
#   echo ""
#   echo "  K. X 11/26/24"
#   echo "  bash script to run reconstructPar in pseudo-parallel mode"
