convertToMeters 1;

vertices
(
    (0 -300 0)
    (4500 -300 0)
    (4500 300 0)
    (0 300 0)
    (0 -300 6000)
    (4500 -300 6000)
    (4500 300 6000)
    (0 300 6000)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (250 40 167) simpleGrading (1 1 1)
);

edges
(
);

defaultPatch
{
    name side;
    type patch;
}

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }
    bottom
    {
        type wall;
        faces
        (
            (0 1 5 4)
        );
    }
    top
    {
        type patch;
        faces
        (
            (2 3 7 6)
        );
    }
);

mergePatchPairs
(
);

