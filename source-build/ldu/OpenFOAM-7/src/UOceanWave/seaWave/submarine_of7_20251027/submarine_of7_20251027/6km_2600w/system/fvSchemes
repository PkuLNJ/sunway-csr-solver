FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default CrankNicolson ocCoeff
    {
        type scale;
        scale linearRamp;
        duration 1.0;
        value 0.9;
    };
}

gradSchemes
{
//    default	cellLimited fourth 1;
    default         Gauss linear;
    grad(U)         Gauss linear;
    grad(alpha1)     Gauss linear;
}

divSchemes
{
//    default	    Gauss linear;
//    div(rhoPhi,U)  Gauss limitedLinearV 1;
    div(rhoPhi,U)       Gauss linearUpwind grad(U);
//    div(phi,gamma)  Gauss vanLeer;
//    div(rho*phi,U)  Gauss MUSCL;
//    div(phi,alpha)  Gauss MUSCL;
    div(phi,alpha)      Gauss vanLeer;
//    div(phirb,alpha) Gauss interfaceCompression;
    div(phirb,alpha)    Gauss linear;
    //div((muEff*dev(T(grad(U))))) Gauss linear;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(phi,TT)      Gauss upwind;
    div(((kk|((Cp*rho)*TT))*grad(TT))) Gauss linear;

    div(((muu+(nut*rho))*dev2(T(grad(U))))) Gauss linear;
    div((interpolate((rho*Cp))*phi),TT) Gauss upwind;
    div(((kk|(Cp*TT))*grad(TT))) Gauss linear;

    div(phi,T) Gauss linearUpwind grad(T);
    div(phi,S) Gauss linearUpwind grad(S);
    "div\(phi,(k|omega)\)"      Gauss upwind;
}

laplacianSchemes
{
    //default         Gauss linear orthogonal;
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    p_rgh;
    pcorr;
    alpha.water;
}

wallDist
{
    method meshWave;
}

