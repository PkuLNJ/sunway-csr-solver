FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application boussinesqFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.05;

deltaT          0.001;

writeControl    adjustableRunTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           20;

maxAlphaCo      1;

maxDeltaT       1;

libs		("libseaWave.so");


functions
{
    lnjFinalSevenFields
    {
        type            writeObjects;
        libs            ("libutilityFunctionObjects.so");
        enabled         true;
        log             true;
        objects         (U p_rgh TT S "alpha[.]water" p rhok);
        writeOption     anyWrite;
        executeControl  none;
        writeControl    runTime;
        writeInterval   0.05;
    }

    surfaces
    {
        enabled         false;
        type            surfaces;
        libs            ("libsampling.so");

        writeControl    adjustableRunTime;
writeInterval   0.05;

        surfaceFormat   vtk;
        fields          (U);

        interpolationScheme cellPoint;

        surfaces
        (
            interface
            {
                type            isoSurface;
                isoField        alpha.water;
                isoValue        0.5;
                interpolate     true;
            }

        yNormal
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   (0 -20 0);
                normal  (0 1 0);
            }
            interpolate     true;
        }

        zNormal
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   (0 0 3000);
                normal  (0 0 1);
            }
            interpolate     true;
        }


        );
    }

}

