FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (10 0 0);

boundaryField
{
    top
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    inlet
    {
        type            waveVelocity;
    }

    outlet
    {
        type            outletPhaseMeanVelocity;
        UnMean          10;
        alpha           alpha.water;
    }

    side
    {
        type            slip;
    }
    bottom
    {
        type            slip;
    }
    submarine
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}


