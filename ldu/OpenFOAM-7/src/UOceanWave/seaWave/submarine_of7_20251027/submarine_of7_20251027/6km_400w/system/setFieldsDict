FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
    volVectorFieldValue U (-10 0.0 0)
);

regions
(
    boxToCell
    {
        box (-10000 -10000 -10000) (10000 10000 20);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
	     volVectorFieldValue U (-10 0 0)
        );
    }
);


