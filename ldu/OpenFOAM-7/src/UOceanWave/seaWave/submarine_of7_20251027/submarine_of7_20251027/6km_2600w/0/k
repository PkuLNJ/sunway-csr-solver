FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 2.16e-2;

boundaryField
{

    top
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    inlet
    {
        type            fixedValue;
        intensity       0.012;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    side
    {
        type            zeroGradient;
    }
     bottom
    {
        type            zeroGradient;
    }
    submarine
    {
        type            kqRWallFunction;
        value           $internalField;
    }
}

